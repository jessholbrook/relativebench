{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativebench.org/schemas/pilot.schema.json",
  "title": "RelativeBench pilot configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_version", "pilot_id", "status", "transition_id", "scenario_manifest", "models", "execution_profiles", "targets"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string" },
    "protocol_version": { "type": "string" },
    "pilot_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["candidate", "active", "complete", "invalidated"] },
    "transition_id": { "type": "string", "minLength": 1 },
    "scenario_manifest": { "type": "string", "minLength": 1 },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous", "new"],
      "properties": {
        "previous": { "$ref": "#/$defs/model" },
        "new": { "$ref": "#/$defs/model" }
      }
    },
    "execution_profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/execution_profile" }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "scenarios_per_category", "judgments_per_response_pair", "minimum_incumbent_evaluators"],
      "properties": {
        "categories": { "type": "integer", "minimum": 1 },
        "scenarios_per_category": { "type": "integer", "minimum": 1 },
        "judgments_per_response_pair": { "type": "integer", "minimum": 1 },
        "minimum_incumbent_evaluators": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "revision"],
      "properties": {
        "id": { "type": "string" },
        "repository": { "type": "string" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "system_instruction", "context_limit", "max_new_tokens", "temperature", "top_p", "top_k", "min_p", "seeds", "model_options"],
      "properties": {
        "id": { "type": "string" },
        "condition": { "enum": ["frozen", "adapted", "learned"] },
        "system_instruction": { "type": "string", "minLength": 1 },
        "context_limit": { "type": "integer", "minimum": 1 },
        "max_new_tokens": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0 },
        "top_p": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "top_k": { "type": "integer", "minimum": 0 },
        "min_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "seeds": { "type": "array", "minItems": 1, "items": { "type": "integer" }, "uniqueItems": true },
        "model_options": { "type": "object" }
      }
    }
  }
}
