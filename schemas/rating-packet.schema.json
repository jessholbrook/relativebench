{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relativebench.org/schemas/rating-packet.schema.json",
  "title": "RelativeBench blinded internal rating packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_version", "packet_id", "session_type", "protocol_version", "condition", "blinding", "pointwise_scale", "paired_scale", "form_selector", "source_run_commitments", "key_commitment_sha256", "pairs", "forms"],
  "properties": {
    "packet_version": { "type": "string" },
    "packet_id": { "$ref": "#/$defs/hash" },
    "session_type": { "const": "internal_interface_pilot" },
    "protocol_version": { "type": "string" },
    "condition": { "const": "frozen" },
    "blinding": { "type": "string" },
    "pointwise_scale": {
      "type": "array",
      "prefixItems": [
        { "const": "fails" },
        { "const": "partially_meets" },
        { "const": "meets" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "paired_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["-2", "-1", "0", "1", "2"],
      "properties": {
        "-2": { "type": "string" },
        "-1": { "type": "string" },
        "0": { "type": "string" },
        "1": { "type": "string" },
        "2": { "type": "string" }
      }
    },
    "form_selector": { "type": "string" },
    "source_run_commitments": {
      "type": "array",
      "items": { "$ref": "#/$defs/hash" },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "key_commitment_sha256": { "$ref": "#/$defs/hash" },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pair" }
    },
    "forms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/form" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "scenario_id", "category", "difficulty", "scoring_mode", "prompt", "rubric", "responses"],
      "properties": {
        "pair_id": { "$ref": "#/$defs/hash" },
        "scenario_id": { "type": "string" },
        "category": { "enum": ["reasoning", "coding", "instruction_following", "structured_output", "factual_synthesis", "safety"] },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "scoring_mode": { "enum": ["objective", "rubric"] },
        "prompt": { "type": "string", "minLength": 1 },
        "rubric": { "type": "string", "minLength": 1 },
        "responses": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["response_id", "text"],
            "properties": {
              "response_id": { "$ref": "#/$defs/hash" },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["form_id", "assignments"],
      "properties": {
        "form_id": { "enum": ["form-a", "form-b"] },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assignment_id", "position", "pair_id", "left_response_id", "right_response_id"],
            "properties": {
              "assignment_id": { "$ref": "#/$defs/hash" },
              "position": { "type": "integer", "minimum": 1 },
              "pair_id": { "$ref": "#/$defs/hash" },
              "left_response_id": { "$ref": "#/$defs/hash" },
              "right_response_id": { "$ref": "#/$defs/hash" }
            }
          }
        }
      }
    }
  }
}
